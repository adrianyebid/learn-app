# Base URL of the java-backend service from gym-system-delivery
# (docker compose -f docker-compose.subtask2.yml up -d exposes it on 8080)
VITE_API_URL=http://localhost:8080/api/v1

# Google reCAPTCHA site key. Leave empty in development to fall back to
# Google's published always-pass test key (see src/config/recaptcha.js).
VITE_RECAPTCHA_SITE_KEY=
